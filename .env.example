# Copy to .env and adjust. Never commit .env.

# Server
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
LOG_LEVEL=info

# Database: leave DATABASE_URL empty to use embedded PGlite (stored in PGLITE_DIR).
# Set it to use a real Postgres, e.g. postgres://pixel:pixel@localhost:5432/pixel_packs
DATABASE_URL=
PGLITE_DIR=.data/pglite

# Auth: client origin for links in emails; secure cookies default to on in production.
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=

# Discord login (optional; README → "Discord login"). Leave empty to hide the Discord buttons.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Defaults to ${APP_ORIGIN}/api/auth/discord/callback; must match a redirect in the Discord app.
DISCORD_REDIRECT_URI=

# PixelLab (local only; cloud sessions use the session proxy)
PIXELLAB_API_KEY=
